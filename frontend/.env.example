# URL of your deployed Render backend (no trailing slash). Use http://localhost:5000 while developing.
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# ImageKit public info (safe to expose in frontend - NOT the private key)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
